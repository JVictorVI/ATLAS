{
  "name": "atlas",
  "displayName": "atlas",
  "publisher": "atlas",
  "license": "UNLICENSED",
  "description": "Assistente Técnico, Lógico e Arquitetural de Software",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/JVictorVI/ATLAS.git"
  },
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:atlas-chat.view",
    "onCommand:atlas.baixarEngineAi"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "atlas-chat-container",
          "title": "ATLAS",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "atlas-chat-container": [
        {
          "type": "webview",
          "id": "atlas-chat.view",
          "name": "Assistente Inteligente"
        }
      ]
    },
    "commands": [
      {
        "command": "atlas.baixarEngineAi",
        "title": "ATLAS: Baixar engine local automaticamente"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "prepare-rag-runtime": "node scripts/copy-chroma-runtime.mjs",
    "prepare-embedding-model": "node scripts/download-embedding-model.mjs",
    "prepare-embedding-runtime": "node scripts/prepare-embedding-runtime.mjs",
    "test-rag-runtime": "npm run prepare-rag-runtime && node scripts/test-chroma-runtime.mjs",
    "test-rag-semantic": "npm run prepare-rag-runtime && npm run prepare-embedding-model && node scripts/test-rag-semantic.mjs",
    "package": "npm run prepare-rag-runtime && npm run prepare-embedding-model && npm run prepare-embedding-runtime && npm run check-types && npm run lint && node esbuild.js --production",
    "vsix": "node scripts/package-vsix.mjs win32-x64",
    "vsix:win32-x64": "node scripts/package-vsix.mjs win32-x64",
    "vsix:linux-x64": "node scripts/package-vsix.mjs linux-x64",
    "vsix:linux-arm64": "node scripts/package-vsix.mjs linux-arm64",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.19",
    "@types/pdf-parse": "^1.1.5",
    "@types/uuid": "^10.0.0",
    "@types/vscode": "^1.110.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "0.27.3",
    "eslint": "^9.39.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "@hey-api/client-fetch": "^0.10.0",
    "@huggingface/transformers": "^3.8.1",
    "@vscode/codicons": "^0.0.45",
    "axios": "^1.18.1",
    "chromadb": "^3.4.3",
    "jszip": "^3.10.1",
    "marked": "^18.0.5",
    "minimatch": "^10.2.4",
    "pdf-parse": "^1.1.1",
    "uuid": "^14.0.0"
  },
  "overrides": {
    "form-data": "4.0.6"
  }
}
